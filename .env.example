CONDUCTOR_DATABASE_URL=sqlite:///data/conductor.db
# Set long, independent random secrets in the service's protected environment.
CONDUCTOR_ADMIN_TOKEN=
CONDUCTOR_REPORT_TOKEN=
# Optional; trusted HTTPS certificate required.
CONDUCTOR_PROXMOX_URL=https://burrow-01.denops.ai:8006
CONDUCTOR_PROXMOX_TOKEN=
CONDUCTOR_PROXMOX_TOKEN_FILE=/opt/proxmox_secret.env
# Optional trusted Proxmox CA PEM; hostname must still match its certificate.
CONDUCTOR_PROXMOX_CA_FILE=/etc/denops-conductor/certs/proxmox-ca.pem

